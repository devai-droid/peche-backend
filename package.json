    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "@types/multer": "^1.4.10",
    "express": "^4.21.2",
    "aws-sdk": "^2.1494.0",
