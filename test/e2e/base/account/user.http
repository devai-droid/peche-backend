> {%
  client.global.set("user_auth_token", response.body);
%}

### me
GET {{api_host}}/users/me
Authorization: Bearer {{user_auth_token}}

### update profile
PUT {{api_host}}/users/me
Authorization: Bearer {{user_auth_token}}
Content-Type: application/json

{
  "languageLocale": "ja"
}
