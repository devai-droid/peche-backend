### login
POST {{xen_host}}/auth/login
Content-Type: application/json

{
  "phoneNumber": "+821012345678",
  "password": "12345678"
}

> {%
  client.global.set("user_auth_token", response.body);
%}

### get product-categories
GET {{xen_host}}/event-categories
Authorization: Bearer {{user_auth_token}}

> {%
  client.global.set("event_category_id", response.body[0].id);
%}

### get product-detail-pages
GET {{xen_host}}/product-detail-pages
Authorization: Bearer {{user_auth_token}}

> {%
  client.global.set("product_detail_page_id", response.body.items[0].id);
%}

### get integrated-crm-categories
GET {{xen_host}}/integrated-crm-categories
Authorization: Bearer {{user_auth_token}}

> {%
  client.global.set("integrated_crm_category_id", response.body[0].id);
%}

### create event bundle
POST {{xen_host}}/event-bundle
Authorization: Bearer {{user_auth_token}}

> {%
  client.global.set("event_bundle_id", response.body.id);
%}

### create event
POST {{xen_host}}/events
Authorization: Bearer {{user_auth_token}}
Content-Type: application/json

{
  "bundleId": "{{event_bundle_id}}",
  "categoryId": "{{event_category_id}}",
  "detailPageId": "{{product_detail_page_id}}",
  "integratedCrmCategoryId": "{{integrated_crm_category_id}}",
  "name": "test product",
  "description": "test",
  "price": 1000,
  "discountPrice": 800,
  "order": 1,
  "visible": true,
  "visibleEN": true,
  "visibleZH": true,
  "visibleJA": true,
  "visibleTH": true,
  "label": ["NEW", "KAKAO"]
}

### get event-bundle
GET {{xen_host}}/event-bundle
Authorization: Bearer {{user_auth_token}}
