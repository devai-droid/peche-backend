### get admin token
POST {{xen_host}}/admin-auth/admin-jwt
Content-Type: application/json

> {%
  client.global.set("admin_auth_token", response.body);
  client.global.set("user_auth_token", response.body);
%}


### create user
POST {{xen_host}}/admin/users
Content-Type: application/json
Authorization: Bearer {{admin_auth_token}}

{
  "email": "test@test.com",
  "password": "peche121"
}

> {%
  client.global.set("user_id", response.body.id);
%}


### set admin user
PUT {{xen_host}}/admin/users/{{user_id}}/admin
Content-Type: application/json
Authorization: Bearer {{admin_auth_token}}


### remove admin user
DELETE {{xen_host}}/admin/users/{{user_id}}/admin
Content-Type: application/json
Authorization: Bearer {{admin_auth_token}}


### get admin user
GET {{xen_host}}/admin/users?role=ADMIN
Content-Type: application/json
Authorization: Bearer {{admin_auth_token}}
