### login
POST {{api_host}}/auth/login
Content-Type: application/json

{
  "phoneNumber": "+821012345678",
  "password": "12345678"
}

> {%
  client.global.set("user_auth_token", response.body);
%}

### create members
POST {{api_host}}/members
Authorization: Bearer {{user_auth_token}}
Content-Type: application/json

{
  "status": "ACTIVE",
  "name": "test-member",
  "occupation": "원장"
}

### get members
GET {{api_host}}/members
Authorization: Bearer {{user_auth_token}}
